    "Транскрипт отправляется только на этот адрес. Разрешены localhost, имена .local и адреса частной сети — облачные адреса отклоняются (SPEC.md §1: вся обработка на этом Mac).": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт надсилається лише на цю адресу. Дозволено localhost, імена .local та адреси приватної мережі — хмарні адреси відхиляються (SPEC.md §1: уся обробка на цьому Mac)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript is sent only to this address. localhost, .local names, and private network addresses are allowed — cloud addresses are rejected (SPEC.md §1: all processing happens on this Mac)."
          }
        }
      }
    },
