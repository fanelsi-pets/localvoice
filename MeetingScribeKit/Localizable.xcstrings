        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдено спікерів: %lld, очікувалося %lld — розділення за голосами на короткому семплі буває неточним; на справжній зустрічі перевірте панель «Спікери»."
          }
        },
        "en": {
          "stringUnit": {
