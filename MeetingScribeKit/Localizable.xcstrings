    },
    " — участник молчал или его микрофон был слишком тихим": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " — учасник мовчав або його мікрофон був надто тихим"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — the participant was silent or their microphone was too quiet"
          }
        }
      }
    },
    "%@\n\nВ файле нет аудио, текста реплик и названий встреч.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nУ файлі немає аудіо, тексту реплік і назв зустрічей."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe file contains no audio, no utterance text, and no meeting titles."
          }
        }
      }
    },
