    " (модель из старого кэша, манифеста нет)": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " (модель зі старого кешу, маніфесту немає)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (model from an old cache, no manifest)"
          }
        }
      }
    },
    " · лучшее сходство %@": {
      "extractionState": "manual",
      "localizations": {
