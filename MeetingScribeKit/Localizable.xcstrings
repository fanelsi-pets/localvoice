    "%@: лучшее качество на русском и украинском": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: the best quality for Russian and Ukrainian"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: найкраща якість російською та українською"
          }
        }
      }
    },
    "%@: мало для длинных записей — обрабатывайте встречи до часа и закрывайте другие приложения": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: замало для довгих записів — обробляйте зустрічі до години та закривайте інші застосунки"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: not enough for long recordings — process meetings of up to an hour and close other apps"
          }
        }
      }
    },
    "%@: не хватает файлов (%@) — скачайте модель заново": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: бракує файлів (%@) — завантажте модель заново"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: files are missing (%@) — download the model again"
          }
        }
      }
    },
    "%@: нужен Mac с Apple Silicon — модели распознавания работают на Neural Engine": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: потрібен Mac з Apple Silicon — моделі розпізнавання працюють на Neural Engine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: an Apple Silicon Mac is required — recognition models run on the Neural Engine"
          }
        }
      }
    },
    "%@: режим «точный» с large-v3 turbo работает, модель large-v3 может не поместиться": {
      "extractionState": "manual",
      "localizations": {
